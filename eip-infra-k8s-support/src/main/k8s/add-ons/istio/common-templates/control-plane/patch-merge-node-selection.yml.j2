#jinja2: lstrip_blocks: "True"
{#
  Patch for istio operator node selectors and tolerations
  INPUTS:
    - params_tmpl:
        target:
        merge:
          nodeSelector:
          tolerations:
          ...
#}
{% set _p = params_tmpl %}
{% set _pt = _p['target'] %}
{% set _pm = _p['merge'] %}
{% set _pmns = _pm['nodeSelector'] | default({}) %}
{% set _pmnt = _pm['tolerations'] | default([]) %}
---
# generated file please do not edit
{# api group could be empty #}
{% if ((_pt['group'] | default('')) | length) > 0 %}
apiVersion: {{ _pt['group'] }}/{{ _pt['version'] }}
{% else %}
apiVersion: {{ _pt['version'] }}
{% endif %}
kind: {{ _pt['kind'] }}
metadata:
  name: {{ _pt['name'] }}
  {% if _pt['namespace'] is defined %}
  namespace: {{ _pt['namespace'] }}
  {% endif %}
{# adjust spec if nodeSelector or tolerations exist #}
{% if (_pmns | length) > 0 and (_pmnt | length) > 0 %}
spec:
  {% if _pm['tag'] is defined %}
  tag: !!str {{ _pm['tag'] }}
  {% endif %}
  components:
    pilot:
      k8s:
      {% if (_pmns | length) > 0 %}
        # PEP #
        nodeSelector:
          {{ _pmns | to_nice_yaml(indent=2, width=1337) | trim | indent(10) }}
      {% endif %}
      {% if (_pmnt | length) > 0 %}
        # PEP #
        tolerations:
          {{ _pmnt | to_nice_yaml(indent=2, width=1337) | trim | indent(10) }}
      {% endif %}

  values:
    global:
      {% if (_pmns | length) > 0 %}
      # PEP #
      defaultNodeSelector:
        {{ _pmns | to_nice_yaml(indent=2, width=1337) | trim | indent(8) }}   
      {% endif %}
      {% if (_pmnt | length) > 0 %}
        # PEP #
      defaultTolerations:
        {{ _pmnt | to_nice_yaml(indent=2, width=1337) | trim | indent(8) }}
      {% endif %}
{% endif %}
