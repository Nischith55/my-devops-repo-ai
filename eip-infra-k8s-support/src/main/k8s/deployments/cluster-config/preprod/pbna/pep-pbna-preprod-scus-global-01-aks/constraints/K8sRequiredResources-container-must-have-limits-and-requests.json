{
  "apiVersion": "constraints.gatekeeper.sh/v1beta1",
  "kind": "K8sRequiredResources",
  "metadata": {
    "annotations": {},
    "name": "container-must-have-limits-and-requests"
  },
  "spec": {
    "enforcementAction": "warn",
    "match": {
      "excludedNamespaces": [
        "calico-system",
        "cattle-fleet-system",
        "cattle-gatekeeper-system",
        "cattle-impersonation-system",
        "cattle-system",
        "istio-system",
        "falcon-kac",
        "falcon-system",
        "kube-node-lease",
        "kube-public",
        "kube-system",
        "kubecost",
        "monitoring",
        "msi-acrpull-system",
        "observability",
        "snyk-monitor",
        "policy-system",
        "internal-services",
        "gatekeeper-system"
      ],
      "kinds": [
        {
          "apiGroups": [
            ""
          ],
          "kinds": [
            "Pod"
          ]
        }
      ],
      "scope": "*"
    },
    "parameters": {
      "exemptImages": [
        "cyberark/secrets-provider-for-k8s*",
        "docker.io/istio/*",
        "docker.elastic.co/observability/*",
        "appdynamics/*",
        "docker.io/appdynamics/*",
        "otel/opentelemetry-collector*"
      ],
      "limits": [
        "cpu",
        "memory"
      ],
      "requests": [
        "cpu",
        "memory"
      ]
    }
  }
}
