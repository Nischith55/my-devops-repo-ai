{
  "apiVersion": "constraints.gatekeeper.sh/v1beta1",
  "kind": "K8sRequiredProbes",
  "metadata": {
    "annotations": {},
    "name": "must-have-probes"
  },
  "spec": {
    "enforcementAction": "warn",
    "match": {
      "excludedNamespaces": [
        "calico-system",
        "cattle-fleet-system",
        "cattle-gatekeeper-system",
        "cattle-impersonation-system",
        "cattle-system",
        "istio-system",
        "kube-node-lease",
        "kube-public",
        "kube-system",
        "kubecost",
        "monitoring",
        "msi-acrpull-system",
        "observability",
        "snyk-monitor",
        "policy-system",
        "falcon-kac",
        "falcon-system",
        "internal-services",
        "gatekeeper-system"
      ],
      "kinds": [
        {
          "apiGroups": [
            ""
          ],
          "kinds": [
            "Pod"
          ]
        }
      ],
      "labelSelector": {
        "matchExpressions": [
          {
            "key": "app",
            "operator": "Exists"
          }
        ]
      },
      "scope": "*"
    },
    "parameters": {
      "probeTypes": [
        "tcpSocket",
        "httpGet",
        "exec"
      ],
      "probes": [
        "readinessProbe"
      ]
    }
  }
}
