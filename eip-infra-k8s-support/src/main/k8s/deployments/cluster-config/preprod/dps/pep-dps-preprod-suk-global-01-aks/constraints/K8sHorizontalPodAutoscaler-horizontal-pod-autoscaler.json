{
  "apiVersion": "constraints.gatekeeper.sh/v1beta1",
  "kind": "K8sHorizontalPodAutoscaler",
  "metadata": {
    "annotations": {},
    "name": "horizontal-pod-autoscaler"
  },
  "spec": {
    "enforcementAction": "warn",
    "match": {
      "kinds": [
        {
          "apiGroups": [
            "autoscaling"
          ],
          "kinds": [
            "HorizontalPodAutoscaler"
          ]
        }
      ]
    },
    "parameters": {
      "enforceScaleTargetRef": true,
      "minimumReplicaSpread": 1,
      "ranges": [
        {
          "max_replicas": 6,
          "min_replicas": 3
        }
      ]
    }
  }
}
