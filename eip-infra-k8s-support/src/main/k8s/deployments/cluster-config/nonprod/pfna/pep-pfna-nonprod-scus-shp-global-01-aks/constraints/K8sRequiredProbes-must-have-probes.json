{
  "apiVersion": "constraints.gatekeeper.sh/v1beta1",
  "kind": "K8sRequiredProbes",
  "metadata": {
    "annotations": {},
    "name": "must-have-probes"
  },
  "spec": {
    "enforcementAction": "warn",
    "match": {
      "excludedNamespaces": [
        "calico-system",
        "cattle-fleet-system",
        "cattle-gatekeeper-system",
        "cattle-impersonation-system",
        "cattle-system",
        "default",
        "istio-operator",
        "istio-system",
        "keda",
        "kube-node-lease",
        "observability",
        "kube-public",
        "kube-system",
        "kubecost",
        "kubernetes-dashboard",
        "local",
        "monitoring",
        "msi-acrpull-system",
        "observability",
        "pep-pfna-elastic-client-01",
        "pep-pfna-istio-config",
        "pep-pfna-ops-admin",
        "tigera-operator",
        "twistlockpp",
        "cert-manager-system",
        "reloader",
        "flux-system",
        "falcon-kac",
        "falcon-system",
        "flagger",
        "pep-pfna-gremlin"
      ],
      "kinds": [
        {
          "apiGroups": [
            ""
          ],
          "kinds": [
            "Pod"
          ]
        }
      ],
      "labelSelector": {
        "matchExpressions": [
          {
            "key": "app",
            "operator": "Exists"
          }
        ]
      },
      "scope": "*"
    },
    "parameters": {
      "probeTypes": [
        "tcpSocket",
        "httpGet",
        "exec"
      ],
      "probes": [
        "readinessProbe"
      ]
    }
  }
}
