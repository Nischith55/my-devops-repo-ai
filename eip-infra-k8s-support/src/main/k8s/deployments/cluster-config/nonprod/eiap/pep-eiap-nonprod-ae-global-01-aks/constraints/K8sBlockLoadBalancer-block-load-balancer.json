{
  "apiVersion": "constraints.gatekeeper.sh/v1beta1",
  "kind": "K8sBlockLoadBalancer",
  "metadata": {
    "name": "block-load-balancer"
  },
  "spec": {
    "enforcementAction": "warn",
    "match": {
      "excludedNamespaces": [
        "istio-system"
      ],
      "kinds": [
        {
          "apiGroups": [
            ""
          ],
          "kinds": [
            "Service"
          ]
        }
      ]
    }
  }
}
