{
  "apiVersion": "constraints.gatekeeper.sh/v1beta1",
  "kind": "K8sContainerRequests",
  "metadata": {
    "annotations": {},
    "name": "container-must-have-requests"
  },
  "spec": {
    "enforcementAction": "warn",
    "match": {
      "excludedNamespaces": [
        "calico-system",
        "cattle-fleet-system",
        "cattle-gatekeeper-system",
        "cattle-impersonation-system",
        "cattle-system",
        "falcon-kac",
        "falcon-system",
        "istio-operator",
        "istio-system",
        "kube-node-lease",
        "kube-public",
        "kube-system",
        "kubecost",
        "kubernetes-dashboard",
        "monitoring",
        "msi-acrpull-system",
        "observability",
        "twistlockp",
        "tigera-operator",
        "pep-eiap-ops-admin",
        "pep-eiap-global-infra",
        "pep-eiap-istio-config",
        "pep-eiap-elastic-client-01",
        "pep-eiap-elastic-client-02",
        "pep-eiap-elastic-cluster-01",
        "pep-eiap-elastic-cluster-02",
        "pep-eiap-elastic-monitor-01",
        "pep-eiap-global-devsecops-prod",
        "cert-manager-system",
        "reloader",
        "flux-system",
        "flagger",
        "policy-system",
        "gitops-connector-system",
        "pep-eiap-gremlin",
        "pep-eiap-global-cmp-prod",
        "pep-eiap-pfna-ipp-prod",
        "pep-eiap-cgf-pepgenx-dev"
      ],
      "kinds": [
        {
          "apiGroups": [
            ""
          ],
          "kinds": [
            "Pod"
          ]
        }
      ],
      "scope": "*"
    },
    "parameters": {
      "cpu": "1",
      "exemptImages": [
        "cyberark/secrets-provider-for-k8s*",
        "docker.io/istio/*",
        "docker.elastic.co/observability/*",
        "appdynamics/*",
        "docker.io/appdynamics/*",
        "pepeiapprodcommonacr.azurecr.io/pep/eiap/latam/gtm/*",
        "pepeiapprodcommonacr.azurecr.io/pep/eip/pbna/smartr/*",
        "pepeiapprodcommonacr.azurecr.io/pep/eip/shared-services/*",
        "otel/opentelemetry-collector*",
        "pepeiapprodcommonacr.azurecr.io/pep/eiap/labelright/labelright-backend-ml-api-2022*",
        "pepeiapprodglobalcommonacr.azurecr.io/pep/eiap/pfb-pricing-solution-webapp-api*",
        "pepeiapprodcommonacr.azurecr.io/pep/eiap/labelright/labelright-model-server-2023*",
        "pepeiapprodcommonacr.azurecr.io/pep/eip/specification-digitization*",
        "pepeiapprodcommonacr.azurecr.io/pbna/svt/svt-softbot-platform*",
        "pepeiapprodcommonacr.azurecr.io/pep/eiap/iai-cv-pepiris-inference-ray-service*"
      ],
      "memory": "2Gi"
    }
  }
}
