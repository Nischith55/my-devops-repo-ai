{
  "apiVersion": "constraints.gatekeeper.sh/v1beta1",
  "kind": "K8sAllowedRepos",
  "metadata": {
    "annotations": {},
    "name": "restrictrepo"
  },
  "spec": {
    "enforcementAction": "warn",
    "match": {
      "excludedNamespaces": [
        "calico-system",
        "cattle-fleet-system",
        "cattle-gatekeeper-system",
        "cattle-impersonation-system",
        "cattle-system",
        "istio-operator",
        "istio-system",
        "kube-node-lease",
        "kube-public",
        "kube-system",
        "kubecost",
        "kubernetes-dashboard",
        "monitoring",
        "msi-acrpull-system",
        "observability",
        "twistlocknp",
        "tigera-operator",
        "pep-eiap-ops-admin",
        "pep-eiap-global-infra-dev",
        "pep-eiap-istio-config",
        "pep-eiap-elastic-client-01",
        "pep-eiap-elastic-client-02",
        "pep-eiap-elastic-cluster-01",
        "pep-eiap-elastic-cluster-02",
        "pep-eiap-elastic-monitor-01",
        "pep-eiap-global-devsecops-dev",
        "snyk-monitor",
        "cert-manager-system",
        "reloader",
        "flux-system",
        "flagger",
        "policy-system",
        "gitops-connector-system",
        "argocd"
      ],
      "kinds": [
        {
          "apiGroups": [
            ""
          ],
          "kinds": [
            "Pod"
          ]
        }
      ],
      "labelSelector": {
        "matchExpressions": []
      },
      "namespaceSelector": {
        "matchExpressions": []
      },
      "scope": "*"
    },
    "parameters": {
      "repos": [
        "myartifactory.mypepsico.com/",
        "artifactory.mypepsico.com/",
        "artifactory.pepsico.pvt/",
        "pepeiapnonprodcommonacr.azurecr.io/",
        "docker.io/istio/",
        "docker.io/rancher/",
        "cyberark/",
        "docker.elastic.co/observability/",
        "appdynamics/",
        "docker.io/appdynamics/",
        "pepeiapnonprodglobalcommonacr.azurecr.io/",
        "openpolicyagent/",
        "otel/",
        "us-docker.pkg.dev/gloo-mesh/",
        "structurizr/onpremises",
        "rancher/",
        "pepnonprodsntacr.azurecr.io/",
        "wiziopublic.azurecr.io/wiz-app/",
        "wizio.azurecr.io/",
        "registry.rancher.com/rancher"
      ]
    }
  }
}
