{
  "apiVersion": "constraints.gatekeeper.sh/v1beta1",
  "kind": "K8sPodDisruptionBudget",
  "metadata": {
    "annotations": {
      "argocd.argoproj.io/tracking-id": "opa-constraints-pep-eiap-nonprod-eus-global-02-aks-dev:constraints.gatekeeper.sh/K8sPodDisruptionBudget:default/pod-distruption-budget"
    },
    "name": "pod-distruption-budget"
  },
  "spec": {
