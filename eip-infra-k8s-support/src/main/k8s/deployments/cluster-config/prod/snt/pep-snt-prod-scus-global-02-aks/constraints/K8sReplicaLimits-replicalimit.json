{
  "apiVersion": "constraints.gatekeeper.sh/v1beta1",
  "kind": "K8sReplicaLimits",
  "metadata": {
    "annotations": {
      "argocd.argoproj.io/tracking-id": "opa-constraints-pep-dps-prod-sea-global-01-aks-production:constraints.gatekeeper.sh/K8sReplicaLimits:default/replicalimit"
    },
    "name": "replicalimit"
  },
  "spec": {
    "enforcementAction": "warn",
    "match": {
      "excludedNamespaces": [
        "gatekeeper-system"
      ],
      "kinds": [
        {
          "apiGroups": [
            "apps"
          ],
          "kinds": [
            "Deployment"
          ]
        }
      ],
      "labelSelector": {
        "matchExpressions": []
      },
      "namespaceSelector": {
        "matchExpressions": []
      },
      "scope": "*"
    },
    "parameters": {
      "ranges": [
        {
          "max_replicas": 15,
          "min_replicas": 0
        }
      ]
    }
  }
}
