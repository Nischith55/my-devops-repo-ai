{
  "apiVersion": "constraints.gatekeeper.sh/v1beta1",
  "kind": "K8sAllowedRepos",
  "metadata": {
    "annotations": {},
    "name": "restrictrepo"
  },
  "spec": {
    "enforcementAction": "deny",
    "match": {
      "excludedNamespaces": [
        "calico-system",
        "cattle-fleet-system",
        "cattle-gatekeeper-system",
        "cattle-impersonation-system",
        "cattle-system",
        "istio-operator",
        "istio-system",
        "kube-node-lease",
        "kube-public",
        "kube-system",
        "kubecost",
        "kubernetes-dashboard",
        "monitoring",
        "msi-acrpull-system",
        "observability",
        "twistlockp",
        "tigera-operator",
        "pep-eiap-ops-admin",
        "pep-eiap-global-infra",
        "pep-eiap-istio-config",
        "pep-eiap-elastic-client-01",
        "pep-eiap-elastic-askadaa-01",
        "pep-eiap-global-devsecops-prod",
        "cert-manager-system",
        "reloader",
        "flux-system",
        "snyk-monitor",
        "flagger",
        "policy-system",
        "gitops-connector-system",
        "pep-eiap-gremlin",
        "cert-manager",
        "opentelemetry-operator-system",
        "gpu-operator",
        "pep-eiap-cgf-nvingest-prod",
        "kuberay"
      ],
      "kinds": [
        {
          "apiGroups": [
            ""
          ],
          "kinds": [
            "Pod"
          ]
        }
      ],
      "labelSelector": {
        "matchExpressions": []
      },
      "namespaceSelector": {
        "matchExpressions": []
      },
      "scope": "*"
    },
    "parameters": {
      "repos": [
        "pepeiapprodcommonacr.azurecr.io/",
        "docker.io/istio/",
        "cyberark/",
        "docker.elastic.co/observability/",
        "appdynamics/",
        "docker.io/appdynamics/",
        "otel/",
        "rancher/",
        "docker.io/rancher/",
        "wiziopublic.azurecr.io/wiz-app/",
        "wizio.azurecr.io/",
        "busybox/",
        "docker.io/library/busybox",
        "docker.io/busybox",
        "us-docker.pkg.dev/gloo-mesh",
        "akeyless/"
      ]
    }
  }
}
