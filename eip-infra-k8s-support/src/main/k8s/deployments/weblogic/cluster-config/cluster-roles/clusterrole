apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: pep-developer-clusterrole
rules: 
-   apiGroups:
    - ''
    resources:
    - nodes
    - namespaces
    - persistentvolumes
    verbs:
    - list
    - watch
-   apiGroups:
    - ''
    resources:
    - podtemplates
    - pods
    - pods/attach
    - pods/binding
    - pods/eviction
    - pods/exec
    - pods/log
    - pods/portforward
    - pods/proxy
    - pods/status
    verbs:
    - '*'