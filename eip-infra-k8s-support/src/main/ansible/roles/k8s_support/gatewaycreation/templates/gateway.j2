---
apiVersion: networking.istio.io/v1beta1
kind: Gateway
metadata:
  name: {{ namespace }}-cv-gw
  namespace: {{ namespace }}
spec:
  selector:
    istio: pep-{{ department }}-ingress-gw01
  servers:
  - hosts:
    - "dummy-passthrough-{{ namespace }}.gw01.{{ aks_type }}.{{ region }}.{{ env }}.azure.intra.pepsico.com"
    name: {{ namespace }}-cv-gw-tls-443
    port:
      name: https-{{ namespace }}-cv-gw-tls-443
      number: 443
      protocol: https
    tls:
      cipherSuites:
      - AES128-GCM-SHA256
      - AES256-GCM-SHA384
      - ECDHE-ECDSA-AES128-SHA
      - ECDHE-ECDSA-AES256-SHA
      - ECDHE-ECDSA-AES128-GCM-SHA256
      - ECDHE-ECDSA-AES256-GCM-SHA384
      - ECDHE-RSA-AES128-GCM-SHA256
      - ECDHE-RSA-AES256-GCM-SHA384
      maxProtocolVersion: TLSV1_3
      minProtocolVersion: TLSV1_2
      mode: PASSTHROUGH
  - hosts:
    - "dummy-{{ namespace }}-443.gw01.{{ aks_type }}.{{ region }}.{{ env }}.azure.intra.pepsico.com"
    name: {{ namespace }}-cv-gw-https-443
    port:
      name: https-{{ namespace }}-cv-gw-443
      number: 443
      protocol: https
    tls:
      cipherSuites:
      - AES128-GCM-SHA256
      - AES256-GCM-SHA384
      - ECDHE-ECDSA-AES128-SHA
      - ECDHE-ECDSA-AES256-SHA
      - ECDHE-ECDSA-AES128-GCM-SHA256
      - ECDHE-ECDSA-AES256-GCM-SHA384
      - ECDHE-RSA-AES128-GCM-SHA256
      - ECDHE-RSA-AES256-GCM-SHA384
      credentialName: {{ cluster }}-gw01-tls
      maxProtocolVersion: TLSV1_3
      minProtocolVersion: TLSV1_2
      mode: SIMPLE
  - hosts:
    - "dummy-{{ namespace }}-80.gw01.{{ aks_type }}.{{ region }}.{{ env }}.azure.intra.pepsico.com"
    name: {{ namespace }}-cv-gw-http-80
    port:
      name: http-{{ namespace }}-cv-gw-80
      number: 80
      protocol: http
    tls:
      httpsRedirect: true
      