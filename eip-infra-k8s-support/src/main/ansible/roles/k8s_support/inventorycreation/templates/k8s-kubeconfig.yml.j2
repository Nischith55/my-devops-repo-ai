apiVersion: v1
clusters:
{% for item in clusters %}
{% if cluster == item.name %}
- cluster:
{% for key,val in item.items() %}
{% if key == "cluster" %}
    {{ val|to_nice_yaml|indent() -}}
{% endif -%}
{% if key == "name" %}
  name: {{ val|indent() }}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
contexts:
{% for item in contexts %}
{% if cluster == item.name %}
- context:
{% for key,val in item.items() %}
{% if key == "context" %}
    {{ val|to_nice_yaml|indent() -}}
{% endif -%}
{% endfor %}
{% endif -%}
{% endfor %}
    namespace: {{ namespace }}
{% for item in contexts %}
{% if cluster == item.name %}
{% for key,val in item.items() %}
{% if key == "name" %}
  {{ key }}: {{ val }}-context
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% for item in contexts %}
{% if cluster == item.name|replace("-context","") %}
current-context: {{ item.name }}
kind: Config
preferences: {}
users:
- name: clusterUser_{{ item.name|replace("-context","") }}
  user:
    auth-provider:
      config:
        apiserver-id: 6dae42f8-4368-4678-94ff-3960e28e3630
        client-id: 80faf920-1908-4b52-b5ef-a8e7bedfc67a
        config-mode: "1"
        environment: AzurePublicCloud
        tenant-id: 42cc3295-cd0e-449c-b98e-5ce5b560c1d3
      name: azure
{% endif %}
{% endfor %}