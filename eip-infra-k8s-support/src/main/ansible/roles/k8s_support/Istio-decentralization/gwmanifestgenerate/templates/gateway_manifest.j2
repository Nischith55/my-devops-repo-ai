#jinja2:variable_start_string:'[%' , variable_end_string:'%]'
---
apiVersion: networking.istio.io/v1beta1
kind: Gateway
metadata:
  name: [% namespace %]-cv-gw
  namespace: [% namespace %]
spec:
  selector:
    istio: pep-[% department %]-ingress-gw01
  servers:
  - hosts:
{% if tls_present %}
{% for items in tls_hosts_list %}
    - [% items %]
{% endfor %}
{% else %}
    - "dummy-passthrough-[% namespace %].gw01.[% aks_type %].[% region %].[% env %].azure.intra.pepsico.com"
{% endif %}
    name: "[% namespace %]-cv-gw-tls-443"
    port:
      name: "https-[% namespace %]-cv-gw-tls-443"
      number: 443
      protocol: https
    tls:
      cipherSuites:
      - AES128-GCM-SHA256
      - AES256-GCM-SHA384
      - ECDHE-ECDSA-AES128-SHA
      - ECDHE-ECDSA-AES256-SHA
      - ECDHE-ECDSA-AES128-GCM-SHA256
      - ECDHE-ECDSA-AES256-GCM-SHA384
      - ECDHE-RSA-AES128-GCM-SHA256
      - ECDHE-RSA-AES256-GCM-SHA384
      maxProtocolVersion: TLSV1_3
      minProtocolVersion: TLSV1_2
      mode: PASSTHROUGH
  - hosts:
{% if common_http_list | length > 0 %}
{% for items in common_http_list %}
    - [% items %]
{% endfor %}
{% else %}
    - "dummy-[% namespace %]-443.gw01.[% aks_type %].[% region %].[% env %].azure.intra.pepsico.com"
{% endif %}
    name: "[% namespace %]-cv-gw-https-443"
    port:
      name: "https-[% namespace %]-cv-gw-443"
      number: 443
      protocol: https
    tls:
      cipherSuites:
      - AES128-GCM-SHA256
      - AES256-GCM-SHA384
      - ECDHE-ECDSA-AES128-SHA
      - ECDHE-ECDSA-AES256-SHA
      - ECDHE-ECDSA-AES128-GCM-SHA256
      - ECDHE-ECDSA-AES256-GCM-SHA384
      - ECDHE-RSA-AES128-GCM-SHA256
      - ECDHE-RSA-AES256-GCM-SHA384
      credentialName: "[% cluster_name %]-gw01-tls"
      maxProtocolVersion: TLSV1_3
      minProtocolVersion: TLSV1_2
      mode: SIMPLE
  - hosts:
{% if hosts_list | length > 0 %}
{% for items in hosts_list %}
    - [% items %]
{% endfor %}
{% else %}
    - "dummy-[% namespace %]-80.gw01.[% aks_type %].[% region %].[% env %].azure.intra.pepsico.com"
{% endif %}
    name: "[% namespace %]-cv-gw-http-80"
    port:
      name: "http-[% namespace %]-cv-gw-80"
      number: 80
      protocol: http
    tls:
      httpsRedirect: true
{% if cust_domain_status %}
{% for items in final_custom_https %}
  - hosts:
    - [% items %]
    name: "[% namespace %]-cv-gw-[% loop.index %]-https-443"
    port:
      name: "https-[% namespace %]-cv-gw-[% loop.index %]-443"
      number: 443
      protocol: https
    tls:
      cipherSuites:
      - AES128-GCM-SHA256
      - AES256-GCM-SHA384
      - ECDHE-ECDSA-AES128-SHA
      - ECDHE-ECDSA-AES256-SHA
      - ECDHE-ECDSA-AES128-GCM-SHA256
      - ECDHE-ECDSA-AES256-GCM-SHA384
      - ECDHE-RSA-AES128-GCM-SHA256
      - ECDHE-RSA-AES256-GCM-SHA384
      credentialName: [% ns_cred_list[items] %]
      maxProtocolVersion: TLSV1_3
      minProtocolVersion: TLSV1_2
      mode: SIMPLE
{% endfor %}
{% endif %}
