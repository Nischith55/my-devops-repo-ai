---
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: {{ builtinvariables_file[item] }}
mountOptions:
  - vers=3.0
  - dir_mode=0777
  - file_mode=0644
  - mfsymlinks
  - nobrl
  - cache=strict
  - actimeo=30
  - uid=1000
  - gid=1000
parameters:
  resourceGroup: {{ var['rg'] }}
{% if builtinvariables_file[item] == "azurefile-premium" or builtinvariables_file[item] == "azurefile-csi-premium" %}
  skuName: Premium_LRS
  storageAccount: {{ var['premiumstorageaccount'] }}
{% elif builtinvariables_file[item] == "azurefile" or builtinvariables_file[item] == "azurefile-csi" %}
  skuName: Standard_LRS
  storageAccount: {{ var['storageaccount'] }}
{% elif builtinvariables_file[item] == "azurefile-stdssd" %}
  skuName: StandardSSD_LRS
  storageAccount: {{ var['storageaccount'] }}
{% else %}
{% endif %}
provisioner: file.csi.azure.com
{% if builtinvariables_file[item] == "azurefile-premium" or builtinvariables_file[item] == "azurefile-csi-premium" or builtinvariables_file[item] == "azurefile-stdssd"%}
reclaimPolicy: Retain
{% elif builtinvariables_file[item] == "azurefile" or builtinvariables_file[item] == "azurefile-csi" %}
reclaimPolicy: Delete
{% else %}
{% endif %}
volumeBindingMode: WaitForFirstConsumer
allowVolumeExpansion: true