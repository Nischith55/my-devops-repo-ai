enableRuntimeDefaultSeccompProfile: true
global:
  cattle:
    psp:
      enabled: false
      clusterId: {{ cluster_id }}
    url: 'https://rancher.{{ region }}.prod.azure.intra.pepsico.com'
image:
  repository: rancher/kubectl
  tag: v1.20.2
securityContext:
  allowPrivilegeEscalation: false
  capabilities:
    drop:
      - ALL
