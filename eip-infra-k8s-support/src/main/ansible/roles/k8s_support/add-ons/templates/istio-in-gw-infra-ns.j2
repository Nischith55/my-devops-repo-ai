apiVersion: networking.istio.io/v1beta1
kind: Gateway
metadata:
  name: {{ prefix }}-{{ infrans }}-cv-gw
  namespace: {{ prefix }}-{{ infrans }}
spec:
  selector:
    istio: {{ prefix }}-ingress-gw01
  servers:
  - hosts:
    - 'dummy-passthrough-{{ prefix }}-{{ infrans }}.gw01.{{ aks_type }}.{{ region }}.{{ env }}.azure.intra.pepsico.com'
    name: {{ prefix }}-{{ infrans }}-cv-gw-tls-443
    port:
      name: https-{{ prefix }}-{{ infrans }}-cv-gw-tls-443
      number: 443
      protocol: https
    tls:
      cipherSuites:
      - AES128-GCM-SHA256
      - AES256-GCM-SHA384
      - ECDHE-ECDSA-AES128-SHA
      - ECDHE-ECDSA-AES256-SHA
      - ECDHE-ECDSA-AES128-GCM-SHA256
      - ECDHE-ECDSA-AES256-GCM-SHA384
      - ECDHE-RSA-AES128-GCM-SHA256
      - ECDHE-RSA-AES256-GCM-SHA384
      maxProtocolVersion: TLSV1_3
      minProtocolVersion: TLSV1_2
      mode: PASSTHROUGH
  - hosts:
    - 'dummy-{{ prefix }}-{{ infrans }}-443.gw01.{{ aks_type }}.{{ region }}.{{ env }}.azure.intra.pepsico.com'
    - {{ prefix }}-nginx{{ wcardforhosts }}
    name: {{ prefix }}-{{ infrans }}-cv-gw-https-443
    port:
      name: https-{{ prefix }}-{{ infrans }}-cv-gw-443
      number: 443
      protocol: https
    tls:
      cipherSuites:
      - AES128-GCM-SHA256
      - AES256-GCM-SHA384
      - ECDHE-ECDSA-AES128-SHA
      - ECDHE-ECDSA-AES256-SHA
      - ECDHE-ECDSA-AES128-GCM-SHA256
      - ECDHE-ECDSA-AES256-GCM-SHA384
      - ECDHE-RSA-AES128-GCM-SHA256
      - ECDHE-RSA-AES256-GCM-SHA384
      - ECDHE-RSA-AES128-SHA
      - ECDHE-RSA-AES256-SHA
      credentialName: {{ resourcename }}-gw01-tls
      maxProtocolVersion: TLSV1_3
      minProtocolVersion: TLSV1_2
      mode: SIMPLE
  - hosts:
    - 'dummy-{{ prefix }}-{{ infrans }}-80.gw01.{{ aks_type }}.{{ region }}.{{ env }}.azure.intra.pepsico.com'
    - {{ prefix }}-nginx{{ wcardforhosts }}
    name: {{ prefix }}-{{ infrans }}-cv-gw-http-80
    port:
      name: http-{{ prefix }}-{{ infrans }}-cv-gw-80
      number: 80
      protocol: http
    tls:
      httpsRedirect: true
