#jinja2: lstrip_blocks: "True"
{# 
  inputs:
    - k8s_ns_name: name of the namespace
    - k8s_ns_params: parameters for namespace 
#}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ k8s_ns_name }}
  {% if k8s_ns_params['labels'] is defined %}
  labels: 
    {% for key, value in k8s_ns_params['labels'].iteritems() %}
    {{ key }}: {{ value }}
    {% endfor %}
  {% endif %}
