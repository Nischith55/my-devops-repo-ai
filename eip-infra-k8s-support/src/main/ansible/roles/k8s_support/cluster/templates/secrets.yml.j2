#jinja2: lstrip_blocks: "True"
{# 
  inputs:
    - k8s_ns_name: name of the namespace
    - k8s_ns_params: parameters for namespace 
#}
{% if k8s_secrets is defined %}
  {% for item in k8s_secrets %}
{# begin -- type -- Opaque -#}    
    {% if item.type == 'Opaque' %}
---
apiVersion: v1
kind: Secret
type: {{ item.type }}
metadata:
  name: {{ item.name }}
  namespace: {{ k8s_ns_name }}
stringData: 
      {% for key, value in item['contents'].iteritems() %}
  {{ key }}: {{ value }}   
      {% endfor %}
    {% endif %}
{# end -- type -- Opaque -#}    
{# begin -- type -- kubernetes.io/dockerconfigjson -#}    
    {% if item.type == 'kubernetes.io/dockerconfigjson' %}
---
apiVersion: v1
kind: Secret
type: {{ item.type }}
metadata:
  name: {{ item.name }}
  namespace: {{ k8s_ns_name }}
stringData:
  .dockerconfigjson: |-
    {
      "auths": {
        {% for registry in item['registries'] %}
          "{{ registry['name'] }}" : {
            "username":"{{ registry['username'] }}",
            "password":"{{ registry['password'] }}",
            "email": "{{ registry['email'] }}",
            "auth": "{{ (registry['username'] + ':' + registry['password']) | string | b64encode }}"
          }
        {% endfor %}
      }
    } 
    {% endif %}
{# end -- type -- kubernetes.io/dockerconfigjson -#}    
  {% endfor %}
{% endif %}
