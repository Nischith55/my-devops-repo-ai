#jinja2: lstrip_blocks: "True"
{# 
  INPUT:
    params_tmpl:
      name:
      namespace:
      secret_data:
        username:
        password:
        email:
        registries: list of registry names
#}
{% set _username = params_tmpl['secret_data']['username'] %}
{% set _password = params_tmpl['secret_data']['password'] %}
{% set _email = params_tmpl['secret_data']['email'] %}
{% set _registries = params_tmpl['secret_data']['registries'] %}
---
# Generated -- please do not edit manually
# {{ ansible_managed }}
apiVersion: v1
kind: Secret
type: kubernetes.io/dockerconfigjson
metadata:
  name: {{ params_tmpl['name'] }}
  namespace: {{ params_tmpl['namespace'] }}
stringData:
  .dockerconfigjson: |-
    {
      "auths": {
        {% for registry in _registries %}
          "{{ registry }}" : {
            "username":"{{ _username }}",
            "password":"{{ _password}}",
            "email": "{{ _email }}",
            "auth": "{{ (_username + ':' + _password) | string | b64encode }}"
          }
        {% endfor %}
      }
    } 
