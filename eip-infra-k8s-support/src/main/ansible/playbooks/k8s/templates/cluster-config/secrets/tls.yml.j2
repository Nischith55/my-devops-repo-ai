#jinja2: lstrip_blocks: "True"
{# 
  INPUT:
    params_tmpl:
      name: name of the secret
      namespace: namespace
      tls_crt:
      tls_key
  IMPORTANT:
    - we are using data!! So everything must be base64 encoded
#}
{% set _p = params_tmpl %}
{% set _p_data = _p['secret_data'] %}
---
# Generated -- please do not edit manually
# {{ ansible_managed }}
apiVersion: v1
kind: Secret
type: kubernetes.io/tls
metadata:
  name: {{ _p['name'] }}
  namespace: {{ _p['namespace'] }}
data:
  tls.crt: {{ _p_data['tls_crt'] }}
  tls.key: {{ _p_data['tls_key'] }}
  {% if _p_data['ca_crt'] is defined %}
  ca.crt: {{ _p_data['ca_crt'] }}
  {% endif %}
