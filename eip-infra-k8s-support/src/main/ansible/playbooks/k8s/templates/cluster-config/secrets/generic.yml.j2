#jinja2: lstrip_blocks: "True"
{# 
  INPUT:
    params_tmpl:
      name: name of the secret
      namespace: namespace
      secret_data: a map of key value pairs
  IMPORTANT:
    - we are base64 encoding !! -- Do not encode it
#}
---
# Generated -- please do not edit manually
# {{ ansible_managed }}
apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: {{ params_tmpl['name'] }}
  namespace: {{ params_tmpl['namespace'] }}
  {% if params_tmpl['labels'] is defined 
    and (params_tmpl['labels'] | length) > 0 %}
  labels:
    {{ params_tmpl['labels'] | to_nice_yaml(indent=2, width=1337) 
      | trim | indent(4) }}
  {% endif %}
data: 
  {% for key, value in params_tmpl['secret_data'].iteritems() %}
  {{ key }}: {{ value | string | b64encode }} 
  {% endfor %}
  {% if params_tmpl['secret_data_encoded'] is defined 
    and (params_tmpl['secret_data_encoded'] | length) > 0 %}
  {{ params_tmpl['secret_data_encoded'] 
    | to_nice_yaml(indent=2, width=1337) | trim | indent(2) }}
  {% endif %}
