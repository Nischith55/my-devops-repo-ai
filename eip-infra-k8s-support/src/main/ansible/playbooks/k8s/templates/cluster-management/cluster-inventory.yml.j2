#jinja2: lstrip_blocks: "True"
{#
  K8S Cluster inventory generator -- for cluster nodes management
  IMPORTANT:
   - Since this is part of inventory -- never EVER have vars in here!
  INPUT:
    params_tmpl: A map of key value pairs
      cluster_group_name: Name of the kubernetes cluster
      nodes: output from kubectl get nodes yaml
#}
---
# Please do not edit this file -- instead regenerate with ansible task
# {{ ansible_managed }}
all:
  children:

    #: Cluster group note must
    {{ params_tmpl['cluster_group_name'] }}: 
      hosts:
        {% for n in params_tmpl['nodes_info'] %}
        {% if n['kind'] == 'Node' %}
        {{ n['metadata']['name'] }}: 
          {% for a in  n['status']['addresses'] %}
          {% if a['type'] == 'InternalIP' %}
          ansible_host: {{ a['address'] }}
          {% endif %}
          {% endfor %}
        {% endif %}
        {% endfor %}

    #: -------------------------------------------
    #: Make this group a child of group that is
    #: statically configured. See the main env inventory file.
    #: -------------------------------------------
    cluster_node_common:
      children:
        {{ params_tmpl['cluster_group_name'] }}:



