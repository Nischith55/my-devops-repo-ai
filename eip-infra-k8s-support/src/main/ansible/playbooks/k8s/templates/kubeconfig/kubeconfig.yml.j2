{% set user_name = params_tmpl['user']['name'] %}
{% set cluster_name = params_tmpl['cluster_info']['name'] %}
{% set context_name = params_tmpl['context']['name'] | default(user_name + '_' + cluster_name) %}
---
# Generated -- please do not edit manually
# {{ ansible_managed }}
apiVersion: v1
kind: Config
preferences: {}
clusters:
  - name: {{ cluster_name }}
    cluster:
      {% for k, v in params_tmpl['cluster_info']['cluster'].iteritems() %}
      {{ k }}: {{ v }}
      {% endfor %}
users:
  - name: {{ user_name }}
    user:
      {% for k, v in params_tmpl['user']['creds'].iteritems() %}
      {{ k }}: {{ v }}
      {% endfor %}      
contexts:
  - name: {{ context_name }}
    context:
      cluster: {{ cluster_name }}
      user: {{ user_name }}
current-context: {{ context_name }}
