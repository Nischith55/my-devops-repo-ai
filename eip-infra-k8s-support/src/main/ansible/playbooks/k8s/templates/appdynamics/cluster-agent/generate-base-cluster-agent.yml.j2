#jinja2: lstrip_blocks: "True"
{#

  TODO ---- 
  INPUTS
    - params_tmpl: a map or object

  # In case you want to re-generate as new, drop the following line
  # Generated:  {{ lookup('pipe','date \"+%Y-%m-%d %H:%M:%S %Z\"') }}
  NOTES
   - rendering whole arrays via to_nice_yaml: trim is required to remove
     the trailing new-line
   - also indent spec is (indentfirst renamed as first)
    indent(s, width=4, first=False, blank=False)
#}
{% set _cluster = params_tmpl['cluster_name'] %}
{% set _p = params_tmpl['params'] %}
{% set _ci = _p['controller_info'] %}
{% set _image = _p['image_info'] %}
{% set _ji = _p['java_info'] %}
{% set _log_config = _p['log_config'] %}
{% if _p['node_params']['node_selector'] is defined %}
{% set _node_selector = _p['node_params']['node_selector'] %}
{% endif %}
{% if _p['node_params']['tolerations'] is defined %}
{% set _tolerations = _p['node_params']['tolerations'] %}
{% endif %}
---
apiVersion: appdynamics.com/v1alpha1
kind: Clusteragent
metadata:
  name: appdynamics-cluster-agent
  namespace: {{ _p['namespace'] }}
spec:
  appName: {{ _cluster }}-cluster-agent
  controllerUrl: https://{{ _ci['host'] }}:{{ _ci['port'] }}
  account: {{ _ci['account_name'] }}
  # log configuration
  {{ _log_config | to_nice_yaml(indent=2) | trim | indent(2) }}
  # sa name MUST match what is configured in operator manifest
  serviceAccountName: appdynamics-cluster-agent
  # docker image info
  {{ _image | to_nice_yaml(indent=2) | trim | indent(2) }}

  # The regular expression for selecting the required namespaces to be
  # monitored in the cluster. This parameter works with the Cluster Agent
  # version 20.9 or later and the Controller version 20.10 or later.
  #UNCOMMENT# nsToMonitorRegex: "pep-eiap-.*-dev"
  # The regular expression for the namespaces that must be excluded from the
  # selected namespaces that matches the regular expression mentioned for
  # nsToMonitorRegex.
  #UNCOMMENT# nsToExcludeRegex:
  {% if _node_selector is defined %}
  nodeSelector:
    {{ _node_selector | to_nice_yaml(indent=2) | trim | indent(4) }}
  {% endif %}
  {% if _tolerations is defined %}
  tolerations:
    {{ _tolerations | to_nice_yaml(indent=2) | trim | indent(4) }}
  {% endif %}

  # ###
  # Java Application auto instrumentation
  # ###
  {{ _ji | to_nice_yaml(indent=2) | trim | indent(2) }}
